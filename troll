local ESPObjects = {}

local function CreateESPObject(player)
    local espObj = {
        Player = player,
        Box = Drawing.new("Square"),
        Tracer = Drawing.new("Line"),
        NameText = Drawing.new("Text"),
        DistanceText = Drawing.new("Text"),
        HealthText = Drawing.new("Text"),
        WeaponText = Drawing.new("Text")
    }
    espObj.Box.Thickness = 1; espObj.Box.Filled = false
    espObj.Tracer.Thickness = 1
    
    for _, text in pairs({espObj.NameText, espObj.DistanceText, espObj.HealthText, espObj.WeaponText}) do
        text.Center = true; text.Outline = true; text.Size = 14
    end
    return espObj
end

local function IsTeammate(player)
    if not player.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function IsVisible(targetPart)
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin).Unit * (targetPart.Position - origin).Magnitude
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, targetPart.Parent}
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    local result = Workspace:Raycast(origin, direction, rayParams)
    return result == nil
end

local function GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = AimbotSettings.FOVRadius

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(AimbotSettings.TargetPart) and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            if AimbotSettings.TeamCheck and IsTeammate(player) then continue end
            
            local targetPart = player.Character[AimbotSettings.TargetPart]
            if AimbotSettings.VisibilityCheck and not IsVisible(targetPart) then continue end

            local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            if onScreen then
                local magnitude = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                if magnitude < shortestDistance then
                    closestPlayer = player
                    shortestDistance = magnitude
                end
            end
        end
    end
    return closestPlayer
end

-- Input Handling
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        AimbotSettings.Aiming = true
    end
    
    if MiscSettings.InfiniteJump and input.KeyCode == Enum.KeyCode.Space then
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        AimbotSettings.Aiming = false
    end
end)

-- Main Render Loop
RunService.RenderStepped:Connect(function()
    -- FOV Update
    FOVCircle.Position = UserInputService:GetMouseLocation()
    FOVCircle.Radius = AimbotSettings.FOVRadius
    FOVCircle.Visible = AimbotSettings.ShowFOV and AimbotSettings.Enabled
    FOVCircle.Color = Color3.fromRGB(unpack(AimbotSettings.FOVColor))

    -- Aimbot / Triggerbot
    if AimbotSettings.Enabled then
        local target = GetClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild(AimbotSettings.TargetPart) then
            if AimbotSettings.Aiming then
                local targetPos = target.Character[AimbotSettings.TargetPart].Position
                local currentCFrame = Camera.CFrame
                local targetCFrame = CFrame.new(currentCFrame.Position, targetPos)
                Camera.CFrame = currentCFrame:Lerp(targetCFrame, AimbotSettings.Smoothness)
            end
            
            if AimbotSettings.TriggerBot then
                local mouseTarget = Mouse.Target
                if mouseTarget and mouseTarget:IsDescendantOf(target.Character) then
                    mouse1click()
                    task.wait(AimbotSettings.TriggerDelay)
                end
            end
        end
    end

    -- Character Modifications (Speed, Jump, Noclip)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local hum = LocalPlayer.Character.Humanoid
        if MiscSettings.SpeedHack then hum.WalkSpeed = MiscSettings.SpeedAmount end
        if MiscSettings.JumpPower then hum.JumpPower = MiscSettings.JumpAmount end
        
        if MiscSettings.NoClip then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end

    -- ESP Rendering
    for player, espObj in pairs(ESPObjects) do
        local character = player.Character
        local isVisible = false

        if ESPSettings.Enabled and character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 and player ~= LocalPlayer then
            if not (ESPSettings.TeamCheck and IsTeammate(player)) then
                local hrp = character.HumanoidRootPart
                local head = character:FindFirstChild("Head")
                local distance = (Camera.CFrame.Position - hrp.Position).Magnitude
                
                if distance <= ESPSettings.MaxDistance then
                    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        isVisible = true
                        local topPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local bottomPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        local boxHeight = math.abs(topPos.Y - bottomPos.Y)
                        local boxWidth = boxHeight * 0.6
                        
                        espObj.Box.Visible = true
                        espObj.Box.Size = Vector2.new(boxWidth, boxHeight)
                        espObj.Box.Position = Vector2.new(pos.X - boxWidth/2, topPos.Y)
                        espObj.Box.Color = Color3.fromRGB(unpack(ESPSettings.BoxColor))

                        if ESPSettings.ShowNames then
                            espObj.NameText.Visible = true
                            espObj.NameText.Text = player.Name
                            espObj.NameText.Position = Vector2.new(pos.X, topPos.Y - 15)
                            espObj.NameText.Color = Color3.fromRGB(unpack(ESPSettings.TextColor))
                        else espObj.NameText.Visible = false end

                        if ESPSettings.ShowDistance then
                            espObj.DistanceText.Visible = true
                            espObj.DistanceText.Text = math.floor(distance) .. "m"
                            espObj.DistanceText.Position = Vector2.new(pos.X, bottomPos.Y + 5)
                            espObj.DistanceText.Color = Color3.fromRGB(unpack(ESPSettings.TextColor))
                        else espObj.DistanceText.Visible = false end
                        
                        if ESPSettings.ShowHealth then
                            espObj.HealthText.Visible = true
                            espObj.HealthText.Text = math.floor(character.Humanoid.Health) .. " HP"
                            espObj.HealthText.Position = Vector2.new(pos.X + boxWidth/2 + 5, topPos.Y)
                            espObj.HealthText.Color = Color3.fromRGB(0, 255, 0)
                        else espObj.HealthText.Visible = false end

                        if ESPSettings.ShowWeapon and character:FindFirstChildOfClass("Tool") then
                            espObj.WeaponText.Visible = true
                            espObj.WeaponText.Text = "[" .. character:FindFirstChildOfClass("Tool").Name .. "]"
                            espObj.WeaponText.Position = Vector2.new(pos.X, bottomPos.Y + 20)
                            espObj.WeaponText.Color = Color3.fromRGB(unpack(ESPSettings.TextColor))
                        else espObj.WeaponText.Visible = false end

                        if ESPSettings.ShowTracers then
                            espObj.Tracer.Visible = true
                            espObj.Tracer.Color = Color3.fromRGB(unpack(ESPSettings.TracerColor))
                            espObj.Tracer.To = Vector2.new(pos.X, bottomPos.Y)
                            
                            if ESPSettings.TracerPosition == "Bottom" then
                                espObj.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            elseif ESPSettings.TracerPosition == "Mouse" then
                                espObj.Tracer.From = UserInputService:GetMouseLocation()
                            else
                                espObj.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, 0)
                            end
                        else espObj.Tracer.Visible = false end
                    end
                end
            end
        end

        if not isVisible then
            espObj.Box.Visible = false; espObj.NameText.Visible = false
            espObj.DistanceText.Visible = false; espObj.HealthText.Visible = false
            espObj.WeaponText.Visible = false; espObj.Tracer.Visible = false
        end
    end
end)

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then ESPObjects[player] = CreateESPObject(player) end
end
Players.PlayerAdded:Connect(function(player) ESPObjects[player] = CreateESPObject(player) end)
Players.PlayerRemoving:Connect(function(player)
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do if type(obj) == "table" and obj.Remove then obj:Remove() end end
        ESPObjects[player] = nil
    end
end)

